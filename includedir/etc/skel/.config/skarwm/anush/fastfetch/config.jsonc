{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
        "top": 2,
        "left": 2
        }
    },
    "display": {
        "color": {
            "keys": "38;2;213;154;114", // THEME: fastfetch_primary
            "title": "38;2;210;197;188", // THEME: fastfetch_foreground
            "separator": "38;2;73;105;157" // THEME: fastfetch_secondary
        },
        "separator": "  ",
        "key": {
            "width": 8
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "custom",
            "format": "\u001b[38;2;213;154;114m────────────────────────────\u001b[0m" // THEME: fastfetch_primary
        },
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kern" },
        { "type": "wm",       "key": "wm" },
        { "type": "shell",    "key": "sh" },
        { "type": "terminal", "key": "term" },
        { "type": "cpu",      "key": "cpu", "format": "{name}", "showPeCoreCount": false },
        { "type": "gpu",      "key": "gpu", "format": "{name}" },
        { "type": "memory",   "key": "ram" },
        { "type": "disk",     "key": "disk" },
        { "type": "uptime",   "key": "up" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
