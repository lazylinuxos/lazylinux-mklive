{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/images/lazylinux.png",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "color": {
            "keys": "38;2;30;90;142",
            "title": "38;2;232;185;59",
            "separator": "90"
        },
        "separator": "  ",
        "key": {
            "width": 8
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "custom",
            "format": "\u001b[38;2;232;185;59m────────────────────────────\u001b[0m"
        },
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kern" },
        { "type": "de",       "key": "de" },
        { "type": "wm",       "key": "wm" },        
        { "type": "shell",    "key": "sh" },
        { "type": "terminal", "key": "term" },
        { "type": "cpu",      "key": "cpu", "format": "{name}", "showPeCoreCount": false },
        { "type": "gpu",      "key": "gpu", "format": "{name}" },
        { "type": "memory",   "key": "ram" },
        { "type": "disk",     "key": "disk" },
        { "type": "uptime",   "key": "up" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}