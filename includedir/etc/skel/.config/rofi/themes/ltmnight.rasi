* {
    /* Base Palette */
    ltmnight0: #1E1D2F; /* background */
    ltmnight1: #282839; /* background-alt */
    ltmnight2: #D9E0EE; /* foreground */
    ltmnight3: #988BA2; /* muted/outline */
    ltmnight4: #F28FAD; /* urgent/error */
    ltmnight5: #FAE3B0; /* warning */
    ltmnight6: #96CDFB; /* highlight/info */
    ltmnight7: #ABE9B3; /* active/success */
    ltmnight8: #89DCEB; /* secondary info */
    ltmnight9: #7AA2F7; /* selected/primary */
    ltmnight10: #CBA6F7; /* accent */
    ltmnight11: #6E6C7E; /* placeholder/prompt */

    /* Main Colors */
    background: rgba(30, 29, 47, 0.90);
    foreground: @ltmnight2;

    /* Accent Colors */
    primary: @ltmnight9;
    accent: @ltmnight10;
    on-primary: @ltmnight2;

    primary-fixed: @ltmnight1;
    on-primary-fixed: @ltmnight2;

    /* Selection */
    selection: rgba(122, 162, 247, 0.20);
    on-selection: @ltmnight2;

    /* Error */
    error: @ltmnight4;
    on-error: @ltmnight0;

    /* Surface */
    surface: rgba(40, 40, 57, 0.90);
    on-surface: @ltmnight2;

    /* Borders */
    outline: @ltmnight3;
    shadow: rgba(0, 0, 0, 0.50);

    /* Highlights */
    highlight: @ltmnight6;

    /* Input */
    prompt: @ltmnight11;
    placeholder: @ltmnight11;

    /* Messages */
    message-background: transparent;
    message-border: @ltmnight8;
    message-text: @ltmnight8;

    error-message: @ltmnight4;
    warning-message: @ltmnight5;
    success-message: @ltmnight7;
    info-message: @ltmnight6;
}